# .env.example — contoh variabel lingkungan untuk CatatKu
#
# CatatKu adalah aplikasi web statis yang berjalan penuh di browser.
# Aplikasi ini TIDAK membutuhkan variabel lingkungan apa pun untuk berjalan,
# dan TIDAK ADA secret/kredensial yang perlu diatur: tidak ada API key,
# tidak ada token, tidak ada koneksi database. Jangan pernah menaruh nilai
# rahasia asli di file ini.
#
# Satu-satunya variabel yang kadang berguna adalah PORT, dan itu pun hanya
# dibaca oleh server statis lokal (bukan oleh aplikasi CatatKu sendiri)
# bila kamu ingin mengganti port bawaan saat menjalankan server:
#
#   PORT=8000 npx serve .
#
# Nilai di bawah ini contoh yang aman dan boleh dibagikan:

PORT=8000
